---
interface Props {
  currentPage: number;
  totalPages: number;
  baseUrl: string;
  pagePrefix?: string;
}

const { currentPage, totalPages, baseUrl, pagePrefix = baseUrl } = Astro.props;

function pageUrl(page: number) {
  if (page === 1) return baseUrl;
  const base = pagePrefix.endsWith('/') ? pagePrefix.slice(0, -1) : pagePrefix;
  return `${base}/${page}`;
}
---

{totalPages > 1 && (
  <nav class="pagination" aria-label="Paginación">
    {currentPage > 1 ? (
      <a href={pageUrl(currentPage - 1)} aria-label="Anterior">&larr;</a>
    ) : (
      <span class="disabled">&larr;</span>
    )}

    {Array.from({ length: totalPages }, (_, i) => i + 1).map((page) =>
      page === currentPage ? (
        <span class="current" aria-current="page">{page}</span>
      ) : (
        <a href={pageUrl(page)}>{page}</a>
      )
    )}

    {currentPage < totalPages ? (
      <a href={pageUrl(currentPage + 1)} aria-label="Siguiente">&rarr;</a>
    ) : (
      <span class="disabled">&rarr;</span>
    )}
  </nav>
)}
