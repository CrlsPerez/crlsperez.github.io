---
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'posts'>;
  single?: boolean;
}

const { post, single = false } = Astro.props;
const { type, title, date, tags, image, alt, youtube, caption } = post.data;
const { Content } = await post.render();

const isVideoFile = !!image && /\.(mp4|webm|ogg|mov)$/i.test(image);

const formattedDate = date.toLocaleDateString('es-ES', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<article class={single ? 'post-single' : 'post-card'}>
  {type === 'image' && image && isVideoFile && (
    <video
      src={image}
      class="post-image"
      controls
      playsinline
      preload="metadata"
      aria-label={alt ?? title ?? ''}
    />
  )}

  {type === 'image' && image && !isVideoFile && (
    <a href={`/posts/${post.slug}`} class="post-image-link">
      <img
        src={image}
        alt={alt ?? title ?? ''}
        class="post-image"
        loading="lazy"
      />
    </a>
  )}

  {type === 'video' && youtube && (
    <div class="post-video">
      <iframe
        src={`https://www.youtube-nocookie.com/embed/${youtube}`}
        title={title ?? 'Video'}
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen
      />
    </div>
  )}

  <div class="post-card-body">
    {title && (
      <h2 class="post-title">
        {single ? title : <a href={`/posts/${post.slug}`}>{title}</a>}
      </h2>
    )}

    {caption && <p class="post-caption">{caption}</p>}

    {(type === 'text' || (!image && !youtube)) && (
      <div class="post-content">
        <Content />
      </div>
    )}

    <footer class="post-meta">
      <time class="post-date" datetime={date.toISOString()}>{formattedDate}</time>
      {tags.length > 0 && (
        <div class="tag-list">
          {tags.map((tag) => (
            <a href={`/tags/${tag}`} class="tag">{tag}</a>
          ))}
        </div>
      )}
    </footer>
  </div>
</article>
