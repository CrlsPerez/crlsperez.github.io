---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import PostCard from '../../../components/PostCard.astro';
import Pagination from '../../../components/Pagination.astro';

export async function getStaticPaths() {
  const POSTS_PER_PAGE = 10;
  const allPosts = await getCollection('posts');

  const allTags = [...new Set(allPosts.flatMap((p) => p.data.tags))];

  return allTags.flatMap((tag) => {
    const tagPosts = allPosts
      .filter((p) => p.data.tags.includes(tag))
      .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

    const totalPages = Math.ceil(tagPosts.length / POSTS_PER_PAGE);

    return Array.from({ length: totalPages }, (_, i) => i + 1).map((page) => ({
      params: { tag, page: page === 1 ? undefined : String(page) },
      props: {
        tag,
        posts: tagPosts.slice((page - 1) * POSTS_PER_PAGE, page * POSTS_PER_PAGE),
        currentPage: page,
        totalPages,
      },
    }));
  });
}

const { tag, posts, currentPage, totalPages } = Astro.props;
---

<Layout title={`#${tag}`}>
  <div class="tag-header">
    <h1>#{tag}</h1>
    <p>{totalPages > 1 ? `Página ${currentPage} de ${totalPages}` : `${posts.length} post${posts.length !== 1 ? 's' : ''}`}</p>
  </div>

  <div class="post-feed">
    {posts.map((post) => <PostCard post={post} />)}
  </div>

  <Pagination
    currentPage={currentPage}
    totalPages={totalPages}
    baseUrl={`/tags/${tag}`}
  />
</Layout>
